<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Kippli</Author>
    <Name>Party Order on Nameplate</Name>
    <Punchline>A simple plugin that displays party order numbers next to party members' nameplates (and possibly your own).</Punchline>
    <Description>Displays each party member's current position in the party order beside their in-game nameplate, making the number easier to identify at a glance for targeting.</Description>
    <RepoUrl>https://github.com/floumitou/XIVPartyNumberNameplate</RepoUrl>
    <Tags>party;nameplate;qol</Tags>
  </PropertyGroup>

    <ItemGroup>
        <Content Include="images\icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
